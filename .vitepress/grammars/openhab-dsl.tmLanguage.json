{
  "name": "openhab-dsl",
  "scopeName": "source.openhab-dsl",
  "aliases": ["dsl", "things", "items", "rules", "sitemap", "xtend", "rulesdsl"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#types-and-classes" },
    { "include": "#item-declarations" },
    { "include": "#keywords" },
    { "include": "#functions" },
    { "include": "#constants" },
    { "include": "#icons" },
    { "include": "#tags" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.openhab-dsl",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.double-slash.openhab-dsl",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.openhab-dsl",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.openhab-dsl",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.openhab-dsl",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.openhab-dsl",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "types-and-classes": {
      "patterns": [
        {
          "match": "\\b(import)\\s+([a-zA-Z0-9_.]+(\\.[A-Z][a-zA-Z0-9_]*|\\*))",
          "captures": {
            "1": { "name": "keyword.control.import.openhab-dsl" },
            "2": { "name": "entity.name.type.class.openhab-dsl" }
          }
        },
        {
          "match": "(?:\\b(instanceof|as|new|val|var)\\s+|(?:catch\\s*\\()\\s*)([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.openhab-dsl" },
            "2": { "name": "entity.name.type.class.openhab-dsl" }
          }
        },
        {
          "name": "entity.name.type.class.openhab-dsl",
          "match": "\\b[A-Z][a-zA-Z0-9_]*(?=[.:])"
        }
      ]
    },
    "item-declarations": {
      "match": "(?i)\\b(Color|Contact|DateTime|Dimmer|Group|Number|Player|Rollershutter|String|Switch|Location|Frame|Default|Text|Selection|Setpoint|Slider|Colorpicker|Chart|Webview|Image|Video|Item|Thing|Bridge|Time|Type)([\\w:\\(,\\)]*)\\s+([\\w.:\\\\]+)",
      "captures": {
        "1": { "name": "storage.type.openhab-dsl" },
        "2": { "name": "support.type.dimension.openhab-dsl" },
        "3": { "name": "variable.other.declaration.openhab-dsl" }
      }
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.rule.openhab-dsl",
          "match": "\\b(rule|when|then|end)\\b"
        },
        {
          "name": "keyword.other.trigger.openhab-dsl",
          "match": "\\b(Time cron|Time is midnight|Time is noon|System started|System shuts down|received update|received command|changed to|changed from|changed|updated|triggered|Item|Thing|Channel|from|to|or|as)\\b"
        },
        {
          "name": "keyword.control.openhab-dsl",
          "match": "\\b(if|else|while|do|for|return|in|instanceof|import|function|new|try|throw|catch|finally|break|continue|switch|case|default|synchronized|Frame|Default|Text|Selection|Setpoint|Slider|Colorpicker|Chart|Webview|Mapview|Item|Thing|Bridge|Channels|Time|Type|Sitemap|sitemap|Strategies|Items)\\b"
        },
        {
          "name": "storage.type.openhab-dsl",
          "match": "\\b(Color|Contact|DateTime|Dimmer|Group|Number|Player|Rollershutter|String|Switch|Location|Image|Video|var|val)\\b"
        },
        {
          "name": "support.type.dimension.openhab-dsl",
          "match": "\\b(Length|Temperature|Pressure|Speed|Intensity|Dimensionless|DimensionLess|Angle|Power|Energy|Illuminance)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.openhab-dsl",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\()"
        },
        {
          "name": "entity.name.function.member.openhab-dsl",
          "match": "\\b(toString|getInstance|intValue|doubleValue|floatValue|postUpdate|sendCommand)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.openhab-dsl",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "support.constant.openhab-dsl",
          "match": "\\b(label|icon|item|mappings|minValue|maxValue|step|switchSupport|height|url|refresh|encoding|visibility|period|service|begin|end|legend|labelcolor|valuecolor|AVG|MIN|MAX|SUM|AND|OR|NAND|NOR|EQUAL|INCREASE|DECREASE|NEXT|PREVIOUS|ON|OFF|OPEN|CLOSED|PLAY|PAUSE|REWIND|FASTFORWARD|STOP|MOVE|UP|DOWN|UNDEF|NULL|null)\\b"
        },
        {
          "name": "support.type.primitive.openhab-dsl",
          "match": "\\b(string|int|boolean|long|float|double|short|char|byte)\\b"
        }
      ]
    },
    "icons": {
      "name": "entity.name.function.icon.openhab-dsl",
      "match": "<[a-zA-Z0-9_]+>"
    },
    "tags": {
      "name": "entity.name.tag.openhab-dsl",
      "match": "\\([a-zA-Z0-9_, ]+\\)"
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.binary.openhab-dsl",
          "match": "\\b0b[01]+\\b"
        },
        {
          "name": "constant.numeric.hex.openhab-dsl",
          "match": "\\b0x[0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.float.openhab-dsl",
          "match": "(?:\\b\\d+\\.\\d+|\\.\\d+)(?:[eE][+-]?\\d+)?[dfDF]?\\b"
        },
        {
          "name": "constant.numeric.integer.openhab-dsl",
          "match": "\\b\\d+(?:[eE][+-]?\\d+)?[dfDF]?\\b"
        }
      ]
    },
    "operators": {
      "name": "keyword.operator.openhab-dsl",
      "match": "(->|=>|===|!==|==|!=|<=|>=|\\+\\+|--|\\+=|-=|\\*=|/=|&&|\\|\\||\\+|-|\\*|/|%|=|<|>|\\||&|\\^|~|\\?|:)"
    },
    "punctuation": {
      "name": "punctuation.separator.openhab-dsl",
      "match": "[{}[\\],.:;()]"
    }
  }
}
