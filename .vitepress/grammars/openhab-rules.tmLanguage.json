{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "openhab-rules",
  "aliases": ["rules", "xtend"],
  "scopeName": "source.openhab-rules",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#types-and-classes"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.openhab-rules",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.double-slash.openhab-rules",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.openhab-rules",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.openhab-rules",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.openhab-rules",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.openhab-rules",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "types-and-classes": {
      "patterns": [
        {
          "match": "\\b(import)\\s+([a-zA-Z0-9_.]+(\\.[A-Z][a-zA-Z0-9_]*|\\*))",
          "captures": {
            "1": {
              "name": "keyword.control.import.openhab-rules"
            },
            "2": {
              "name": "entity.name.type.class.openhab-rules"
            }
          }
        },
        {
          "match": "(?:\\b(instanceof|as|new|val|var)\\s+|(?:catch\\s*\\()\\s*)([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.openhab-rules"
            },
            "2": {
              "name": "entity.name.type.class.openhab-rules"
            }
          }
        },
        {
          "name": "entity.name.type.class.openhab-rules",
          "match": "\\b[A-Z][a-zA-Z0-9_]*(?=[.:])"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.rule.openhab-rules",
          "match": "\\b(rule|when|then|end)\\b"
        },
        {
          "name": "keyword.other.trigger.openhab-rules",
          "match": "\\b(Time cron|Time is midnight|Time is noon|System started|System shuts down|received update|received command|changed to|changed from|changed|updated|triggered|Item|Thing|Channel|from|to|or|as)\\b"
        },
        {
          "name": "keyword.control.openhab-rules",
          "match": "\\b(if|else|while|do|for|return|in|instanceof|import|function|new|try|throw|catch|finally|break|continue|switch|case|default|synchronized)\\b"
        },
        {
          "name": "storage.type.openhab-rules",
          "match": "\\b(var|val)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.openhab-rules",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "support.constant.openhab-rules",
          "match": "\\b(INCREASE|DECREASE|NEXT|PREVIOUS|ON|OFF|OPEN|CLOSED|PLAY|PAUSE|REWIND|FASTFORWARD|STOP|MOVE|UP|DOWN|UNDEF|NULL|null)\\b"
        },
        {
          "name": "support.type.primitive.openhab-rules",
          "match": "\\b(string|int|boolean|long|float|double|short|char|byte)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.openhab-rules",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\()"
        },
        {
          "name": "entity.name.function.member.openhab-rules",
          "match": "\\b(toString|getInstance|intValue|doubleValue|floatValue)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.binary.openhab-rules",
          "match": "\\b0b[01]+\\b"
        },
        {
          "name": "constant.numeric.hex.openhab-rules",
          "match": "\\b0x[0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.float.openhab-rules",
          "match": "(?:\\b\\d+\\.\\d+|\\.\\d+)(?:[eE][+-]?\\d+)?[dfDF]?\\b"
        },
        {
          "name": "constant.numeric.integer.openhab-rules",
          "match": "\\b\\d+(?:[eE][+-]?\\d+)?[dfDF]?\\b"
        }
      ]
    },
    "operators": {
      "name": "keyword.operator.openhab-rules",
      "match": "(->|=>|===|!==|==|!=|<=|>=|\\+\\+|--|\\+=|-=|\\*=|/=|&&|\\|\\||\\+|-|\\*|/|%|=|<|>|\\||&|\\^|~|\\?|:)"
    },
    "punctuation": {
      "name": "punctuation.separator.openhab-rules",
      "match": "[{}[\\],.:;()]"
    }
  }
}
